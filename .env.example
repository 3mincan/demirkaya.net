# Mailgun HTTP API (https://app.mailgun.com/settings/api_security)
MAILGUN_API_KEY=key-...
# Sending domain verified in Mailgun (e.g. mg.demirkaya.net or demirkaya.net)
MAILGUN_DOMAIN=mg.demirkaya.net
# Optional: use https://api.eu.mailgun.net for EU region accounts
# MAILGUN_API_BASE=https://api.eu.mailgun.net
# From address must be on MAILGUN_DOMAIN (or authorized)
MAIL_FROM=noreply@mg.demirkaya.net
MAIL_FROM_NAME=demirkaya.net
CONTACT_TO=e.demirkaya@gmail.com
